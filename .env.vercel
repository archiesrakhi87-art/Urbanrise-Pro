# UrbanrisePro — Vercel Environment Variables
# Import this file in Vercel: Settings → Environment Variables → Import .env
# Fill in every placeholder marked with <...> before importing.

# ── Database ──────────────────────────────────────────────────────────────────
# Your Neon connection string (postgres://user:pass@host/db?sslmode=require)
DATABASE_URL=<your-neon-connection-string>

# ── Session & Auth ────────────────────────────────────────────────────────────
# Use the same values you set in your Replit secrets
SESSION_SECRET=<your-session-secret>
ADMIN_SECRET=<your-admin-secret>

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── CORS (optional) ───────────────────────────────────────────────────────────
# *.vercel.app is already allowed by the API; set this if you use a custom domain
# ALLOWED_ORIGINS=https://your-custom-domain.com
